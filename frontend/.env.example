# ─── ShopWave Frontend ───────────────────────────────────────────────────────
# Copy to .env and adjust:  cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to client code.
# NOTE: everything here is baked into the static bundle at BUILD time and is
# publicly visible. Never put a secret in this file.

# One base URL per microservice (local development).
VITE_AUTH_API_URL=http://localhost:4001
VITE_PRODUCT_API_URL=http://localhost:4002
VITE_CART_API_URL=http://localhost:4003
VITE_ORDER_API_URL=http://localhost:4004

# When you put an ALB / CloudFront in front of the services, set this instead
# and leave the four URLs above unset. All four services are then addressed
# through this one origin, and the ALB Ingress routes by path prefix
# (/api/auth, /api/products, /api/categories, /api/cart, /api/orders).
# VITE_API_GATEWAY_URL=https://api.shopwave.example.com

VITE_APP_NAME=ShopWave
