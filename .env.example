# ── ShopWave — compose-level env (read by `docker compose` for ${VAR}) ──
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

POSTGRES_USER=shopwave
POSTGRES_PASSWORD=shopwave_dev_pw
POSTGRES_DB=ecommerce

# REQUIRED, no default in compose. Generate with:  openssl rand -hex 48
JWT_SECRET=