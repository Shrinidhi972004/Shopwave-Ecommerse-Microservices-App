# ─── Cart Service ────────────────────────────────────────────────────────────
# Copy to .env and fill in real values:  cp .env.example .env

PORT=4003
NODE_ENV=development

# PostgreSQL. On AWS this becomes your RDS endpoint.
# Format: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce

# Set to "true" when connecting to RDS (which requires TLS).
PGSSL=false

# ─── JWT ─────────────────────────────────────────────────────────────────────
# MUST be byte-identical to auth-service's JWT_SECRET — this service verifies
# tokens that auth-service signed.
JWT_SECRET=dev-only-secret-change-me-openssl-rand-hex-48
JWT_ISSUER=shopwave-auth

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Upstream services ───────────────────────────────────────────────────────
# Cart calls product-service to resolve product name/price/stock.
# In Kubernetes these become cluster DNS names, e.g. http://product-service:4002
PRODUCT_SERVICE_URL=http://localhost:4002
HTTP_TIMEOUT_MS=5000
