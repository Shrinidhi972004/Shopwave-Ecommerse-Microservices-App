# ─── Auth Service ────────────────────────────────────────────────────────────
# Copy to .env and fill in real values:  cp .env.example .env

# HTTP port this service listens on
PORT=4001
NODE_ENV=development

# PostgreSQL. On AWS this becomes your RDS endpoint.
# Format: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce

# Set to "true" when connecting to RDS (which requires TLS).
PGSSL=false

# ─── JWT ─────────────────────────────────────────────────────────────────────
# MUST be identical across all four services — they all verify the same token.
# Generate one with:  openssl rand -hex 48
JWT_SECRET=dev-only-secret-change-me-openssl-rand-hex-48
JWT_EXPIRES_IN=2h
JWT_ISSUER=shopwave-auth

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (the frontend).
# In production this becomes your CloudFront domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# bcrypt cost factor. 10 is a sane default; raise for production.
BCRYPT_ROUNDS=10
